# Copy to .env (git-ignored). run-local.sh creates it automatically with a random secret.
# Any config key in conf/ezbookkeeping.ini can be overridden as EBK_<SECTION>_<KEY>.

# Required: signing secret. Generate with: openssl rand -hex 32
EBK_SECURITY_SECRET_KEY=

# Serve the freshly built frontend from ./dist when running from source
EBK_SERVER_STATIC_ROOT_PATH=dist
EBK_SERVER_HTTP_PORT=8080

# Investments (added by Expbook): price provider credentials go here, never in source.
# EBK_INVESTMENTS_PRICE_API_KEY=
